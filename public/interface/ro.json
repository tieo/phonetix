  "plain": {
    "categories": {
      "mood": {
        "plain": "Cum înțelege vorbitorul ce spune verbul: ca fapt, ca ceva dorit, pus la îndoială sau imaginat, ori ca ordin."
      },
      "tense": {
        "plain": "Când se întâmplă: înainte de acum, acum sau mai târziu."
      },
      "aspect": {
        "plain": "Cum e privită acțiunea: ca un întreg încheiat, sau ca ceva în desfășurare, repetat ori neterminat."
      },
      "person": {
        "plain": "Cine o face: vorbitorul (eu, noi), cel căruia i se vorbește (tu, voi) sau altcineva (el, ea, ei)."
      },
      "number": {
        "plain": "Câți: unul sau mai mulți."
      },
      "case": {
        "plain": "Forma pe care o ia un substantiv ca să-și arate rolul în propoziție: cine face ceva, cui, al cui, unde."
      },
      "gender": {
        "plain": "O clasă din care face parte fiecare substantiv și după care se acordă cuvintele din jur. Are puțin de-a face cu sexul: germanul das Mädchen, fata, este neutru."
      },
      "definiteness": {
        "plain": "Dacă e vorba de un anume lucru cunoscut (casa) sau de oricare (o casă)."
      },
      "declension": {
        "plain": "Setul de terminații pe care le ia un substantiv sau un adjectiv, în funcție de cuvintele din jur."
      },
      "degree": {
        "plain": "Cât de puternic se aplică un adjectiv: mare, mai mare, cel mai mare."
      },
      "voice": {
        "plain": "Dacă subiectul face acțiunea (ea a scris-o) sau o suferă (a fost scrisă)."
      },
      "register": {
        "plain": "Cât de formal este cuvântul: pentru străini și texte oficiale, sau pentru prieteni."
      },
      "nonfinite": {
        "plain": "O formă a verbului care numește acțiunea fără să spună cine o face sau când: a merge, mergând, mers."
      }
    },
    "values": {
      "singular": {
        "plain": "Un singur lucru.",
        "example": "un *câine*"
      },
      "plural": {
        "plain": "Mai mult de unul.",
        "example": "doi *câini*"
      },
      "dual": {
        "plain": "Exact doi, în limbile care au o formă doar pentru perechi.",
        "example": "slovenă *hiši*, două case"
      },
      "first-person": {
        "plain": "Vorbitorul: eu sau noi.",
        "example": "*eu* merg, *noi* mergem"
      },
      "second-person": {
        "plain": "Cel căruia i se vorbește: tu.",
        "example": "*tu* mergi"
      },
      "third-person": {
        "plain": "Oricine altcineva: el, ea, ei, ele.",
        "example": "*ea merge*"
      },
      "nominative": {
        "plain": "Cel care face acțiunea: subiectul.",
        "example": "*Câinele* mușcă omul."
      },
      "accusative": {
        "plain": "Cel asupra căruia se face acțiunea: complementul direct.",
        "example": "Câinele mușcă *omul*."
      },
      "dative": {
        "plain": "Cel căruia i se dă sau i se face ceva: cui.",
        "example": "Îi dau *omului* o carte."
      },
      "genitive": {
        "plain": "Al cui este, sau din ce face parte: al, a, ai, ale.",
        "example": "cartea *omului*, acoperișul *casei*"

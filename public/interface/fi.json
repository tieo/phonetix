  "plain": {
    "categories": {
      "mood": {
        "plain": "Miten puhuja tarkoittaa sen, mitä verbi sanoo: tosiasiana, toiveena, epäilynä tai kuviteltuna, tai käskynä."
      },
      "tense": {
        "plain": "Milloin se tapahtuu: ennen nykyhetkeä, nyt tai myöhemmin."
      },
      "aspect": {
        "plain": "Miten tekeminen nähdään: yhtenä valmiina kokonaisuutena, tai jatkuvana, toistuvana tai keskeneräisenä."
      },
      "person": {
        "plain": "Kuka sen tekee: puhuja (minä, me), puhuteltava (sinä, te) vai joku muu (hän, he)."
      },
      "number": {
        "plain": "Kuinka monta: yksi vai useampi."
      },
      "case": {
        "plain": "Muoto, jonka nomini saa näyttääkseen tehtävänsä lauseessa: kuka tekee, kenelle, kenen, missä."
      },
      "gender": {
        "plain": "Luokka, johon jokainen substantiivi kuuluu ja jonka mukaan ympäröivät sanat taipuvat. Sillä on vähän tekemistä sukupuolen kanssa: saksan das Mädchen, tyttö, on neutri."
      },
      "definiteness": {
        "plain": "Onko kyse tietystä, tunnetusta (the house) vai mistä tahansa (a house)."
      },
      "declension": {
        "plain": "Päätteet, jotka substantiivi tai adjektiivi saa ja jotka riippuvat ympäröivistä sanoista."
      },
      "degree": {
        "plain": "Kuinka vahvasti adjektiivi pätee: iso, isompi, isoin."
      },
      "voice": {
        "plain": "Tekeekö subjekti teon (hän kirjoitti sen) vai kohdistuuko teko siihen (se kirjoitettiin)."
      },
      "register": {
        "plain": "Kuinka muodollinen sana on: vieraille ja virallisiin teksteihin vai ystäville."
      },
      "nonfinite": {
        "plain": "Verbimuoto, joka nimeää teon kertomatta, kuka sen tekee tai milloin: mennä, menevä, mennyt."
      }
    },
    "values": {
      "singular": {
        "plain": "Yksi jotakin.",
        "example": "*koira*"
      },
      "plural": {
        "plain": "Enemmän kuin yksi.",
        "example": "*koirat*"
      },
      "dual": {
        "plain": "Täsmälleen kaksi, kielissä joissa on oma muoto vain pareille.",
        "example": "sloveeni *hiši*, kaksi taloa"
      },
      "first-person": {
        "plain": "Puhuja: minä tai me.",
        "example": "*minä* kävelen, *me* kävelemme"
      },
      "second-person": {
        "plain": "Puhuteltava: sinä tai te.",
        "example": "*sinä* kävelet"
      },
      "third-person": {
        "plain": "Kuka tahansa muu: hän, se, he, ne.",
        "example": "*hän kävelee*"
      },
      "nominative": {
        "plain": "Teon tekijä: subjekti.",
        "example": "*Koira* puree miestä."
      },
      "accusative": {
        "plain": "Se, johon teko kohdistuu: suora objekti.",
        "example": "Koira puri *miehen*."
      },

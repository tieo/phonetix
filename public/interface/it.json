  "plain": {
    "categories": {
      "mood": {
        "plain": "Come chi parla intende ciò che dice il verbo: come un fatto, come qualcosa di desiderato, dubitato o immaginato, oppure come un ordine."
      },
      "tense": {
        "plain": "Quando accade: prima di adesso, adesso o più tardi."
      },
      "aspect": {
        "plain": "Come si vede l'azione: come un tutto concluso, oppure come qualcosa che continua, si ripete o non è finito."
      },
      "person": {
        "plain": "Chi lo fa: chi parla (io, noi), chi ascolta (tu) o qualcun altro (lui, lei, loro)."
      },
      "number": {
        "plain": "Quanti: uno, o più di uno."
      },
      "case": {
        "plain": "La forma che prende un nome per mostrare il suo ruolo nella frase: chi fa qualcosa, a chi, di chi, dove."
      },
      "gender": {
        "plain": "Una classe a cui appartiene ogni nome, e le parole intorno cambiano per adeguarsi. Ha poco a che fare con il sesso: in tedesco das Mädchen, la ragazza, è neutro."
      },
      "definiteness": {
        "plain": "Se si tratta di una cosa particolare e nota (la casa) o di una qualunque (una casa)."
      },
      "declension": {
        "plain": "L'insieme delle desinenze che prendono un nome o un aggettivo, a seconda delle parole intorno."
      },
      "degree": {
        "plain": "Quanto forte è un aggettivo: grande, più grande, il più grande."
      },
      "voice": {
        "plain": "Se il soggetto compie l'azione (lei ha scritto) o la subisce (è stato scritto)."
      },
      "register": {
        "plain": "Quanto la parola è formale: per estranei e testi ufficiali, oppure per gli amici."
      },
      "nonfinite": {
        "plain": "Una forma del verbo che nomina l'azione senza dire chi la fa né quando: andare, andando, andato."
      }
    },
    "values": {
      "singular": {
        "plain": "Uno di qualcosa.",
        "example": "un *cane*"
      },
      "plural": {
        "plain": "Più di uno.",
        "example": "due *cani*"
      },
      "dual": {
        "plain": "Esattamente due, nelle lingue che hanno una forma solo per le coppie.",
        "example": "sloveno *hiši*, due case"
      },
      "first-person": {
        "plain": "Chi parla: io, o noi.",
        "example": "*io* cammino, *noi* camminiamo"
      },
      "second-person": {
        "plain": "Chi ascolta: tu.",
        "example": "*tu* cammini"
      },
      "third-person": {
        "plain": "Chiunque altro: lui, lei, esso, loro.",
        "example": "*lei* cammina"
      },
      "nominative": {
        "plain": "Chi compie l'azione: il soggetto.",
        "example": "*Il cane* morde l'uomo."
      },
      "accusative": {
        "plain": "Colui su cui si compie l'azione: il complemento oggetto.",
        "example": "Il cane morde *l'uomo*."
      },
      "dative": {
        "plain": "Colui a cui qualcosa viene dato o fatto: a chi.",
        "example": "Do un libro *all'uomo*."
      },
      "genitive": {
        "plain": "Di chi è, o di che cosa fa parte: di.",
        "example": "il libro *dell'uomo*, il tetto *della casa*"
      },
      "vocative": {
        "plain": "La forma usata per chiamare o rivolgersi direttamente a qualcuno.",
        "example": "polacco *Anno!*, Anna!"
      },
      "instrumental": {
        "plain": "Ciò con cui o da cui qualcosa viene fatto.",
        "example": "russo писать *ручкой*, scrivere *con una penna*"
      },
      "locative": {
        "plain": "Dove si trova qualcosa.",
        "example": "polacco w *domu*, *in casa*"
      },
      "prepositional": {
        "plain": "La forma che un nome prende dopo certe preposizioni, soprattutto su dove o su che cosa.",
        "example": "russo о *книге*, *del libro*"
      },
      "ablative": {
        "plain": "Via da, fuori da, o per mezzo di qualcosa.",
        "example": "latino *Romā*, da Roma"
      },
      "partitive": {
        "plain": "Una parte di qualcosa, o un'azione non portata fino in fondo.",
        "example": "finlandese *vettä*, dell'acqua"
      },
      "inessive": {
        "plain": "Dentro qualcosa.",

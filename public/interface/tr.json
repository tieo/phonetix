      },
      "person": {
        "plain": "Kimin yaptığı: konuşan (ben, biz), karşısındaki (sen) ya da başka biri (o, onlar)."
      },
      "number": {
        "plain": "Kaç tane: bir ya da birden fazla."
      },
      "case": {
        "plain": "Bir ismin cümledeki işini göstermek için aldığı biçim: kim bir şey yapıyor, kime, kimin, nerede."
      },
      "gender": {
        "plain": "Her ismin ait olduğu ve çevresindeki sözcüklerin ona uymak için değiştiği bir sınıf. Cinsiyetle pek ilgisi yoktur: Almanca das Mädchen, kız, nötrdür."
      },
      "definiteness": {
        "plain": "Bir şeyin belli, bilinen tek bir şey mi (ev), yoksa herhangi biri mi (bir ev) olduğu."
      },
      "declension": {
        "plain": "Bir isim ya da sıfatın, çevresindeki sözcüklere göre aldığı ekler kümesi."
      },
      "degree": {
        "plain": "Bir sıfatın ne kadar güçlü olduğu: büyük, daha büyük, en büyük."
      },
      "voice": {
        "plain": "Öznenin eylemi yapıp yapmadığı (o yazdı) ya da eylemin ona yapılıp yapılmadığı (yazıldı)."
      },
      "register": {
        "plain": "Sözcüğün ne kadar resmi olduğu: yabancılar ve resmi yazılar için mi, yoksa arkadaşlar için mi."
      },
      "nonfinite": {
        "plain": "Kimin ya da ne zaman yaptığını söylemeden eylemi adlandıran fiil biçimi: gitmek, giderken, gitmiş."
      }

  "plain": {
    "categories": {
      "mood": {
        "plain": "说话人怎样看待动词所说的事：当作事实、愿望、怀疑或想象，或当作命令。"
      },
      "tense": {
        "plain": "事情什么时候发生：现在之前、现在或以后。"
      },
      "aspect": {
        "plain": "怎样看待动作：作为一个完整结束的整体，或作为正在进行、反复或未完成的动作。"
      },
      "person": {
        "plain": "谁做的：说话人（我、我们）、听话人（你）或其他人（他、她、他们）。"
      },
      "number": {
        "plain": "多少：一个，或不止一个。"
      },
      "case": {
        "plain": "名词为表示它在句中的作用而采用的形式：谁做事、对谁、谁的、在哪里。"
      },
      "gender": {
        "plain": "每个名词所属的类别，周围的词要随之变化。它和生理性别关系不大：德语 das Mädchen（女孩）是中性。"
      },
      "definiteness": {
        "plain": "指的是特定的、已知的那一个（这座房子），还是任意一个（一座房子）。"
      },
      "declension": {
        "plain": "名词或形容词所带的一套词尾，取决于周围的词。"
      },
      "degree": {
        "plain": "形容词的程度：大、更大、最大。"
      },
      "voice": {
        "plain": "主语是做动作的一方（她写了它），还是承受动作的一方（它被写出来了）。"
      },
      "register": {
        "plain": "这个词有多正式：对陌生人和公文用，还是对朋友用。"
      },
      "nonfinite": {
        "plain": "只说出动作、不说谁做或何时做的动词形式：to go、going、gone。"
      }
    },
    "values": {
      "singular": {
        "plain": "一个。",
        "example": "one *dog*，一只狗"
      },
      "plural": {
        "plain": "不止一个。",
        "example": "two *dogs*，两只狗"
      },
      "dual": {
        "plain": "正好两个，用于有专门表示成对形式的语言。",
        "example": "斯洛文尼亚语 *hiši*，两座房子"
      },
      "first-person": {
        "plain": "说话人：我，或我们。",
        "example": "*我*走，*我们*走"
      },
      "second-person": {
        "plain": "听话人：你。",
        "example": "*你*走"
      },
      "third-person": {
        "plain": "其他任何人：他、她、它、他们。",
        "example": "*她*走"
      },
      "nominative": {
        "plain": "做动作的一方：主语。",
        "example": "*The dog* bites the man.，狗咬了那个人。"
      },
      "accusative": {
        "plain": "承受动作的一方：直接宾语。",
        "example": "The dog bites *the man*.，狗咬了那个人。"
      },
      "dative": {
        "plain": "接受某物或为之做事的一方：给谁。",
        "example": "I give *the man* a book.，我给那个人一本书。"
      },
      "genitive": {
        "plain": "是谁的，或是什么的一部分：of、's。",
        "example": "*the man's* book, the roof *of the house*，那个人的书，房子的屋顶"
      },
      "vocative": {
        "plain": "直接称呼某人时用的形式。",
        "example": "波兰语 *Anno!*，安娜！"
      },
      "instrumental": {
        "plain": "用什么做某事，或由什么做成。",
        "example": "俄语 писать *ручкой*，*用钢笔*写"
      },
      "locative": {
        "plain": "某物在哪里。",
        "example": "波兰语 w *domu*，*在房子里*"
      },
      "prepositional": {
        "plain": "名词在某些介词后的形式，多表示在哪里或关于什么。",
        "example": "俄语 о *книге*，关于*这本书*"
      },
      "ablative": {
        "plain": "离开、出自某物，或借助某物。",
        "example": "拉丁语 *Romā*，从罗马"
      },
      "partitive": {
        "plain": "某物的一部分，或没有做完的动作。",
        "example": "芬兰语 *vettä*，一些水"
      },
      "inessive": {
        "plain": "在某物里面。",
        "example": "芬兰语 *talossa*，在房子里"
      },
      "elative": {
        "plain": "从某物里面出来。",
        "example": "芬兰语 *talosta*，从房子里出来"
      },
      "illative": {
        "plain": "进入某物。",
        "example": "芬兰语 *taloon*，进入房子"
      },
      "adessive": {
        "plain": "在某物上或旁边。",
        "example": "芬兰语 *pöydällä*，在桌子上"
      },
      "allative": {
        "plain": "到某物上或向某物。",
        "example": "芬兰语 *pöydälle*，到桌子上"
      },
      "essive": {
        "plain": "暂时作为某种身份或处于某种状态。",
        "example": "芬兰语 *lapsena*，作为孩子"
      },
      "translative": {
        "plain": "变成某物。",
        "example": "芬兰语 *opettajaksi*，（成为）老师"
      },
      "abessive": {
        "plain": "没有某物。",
        "example": "芬兰语 *rahatta*，没有钱"
      },
      "comitative": {
        "plain": "和某物一起。",
        "example": "爱沙尼亚语 *sõbraga*，和朋友一起"
      },
      "masculine": {
        "plain": "名词所分的类别之一；阳性名词周围的词采用相应的词尾。多半取决于词本身，而不是生理性别。",
        "example": "西班牙语 *el libro*，书"
      },
      "feminine": {
        "plain": "名词所分的类别之一；阴性名词周围的词采用相应的词尾。多半取决于词本身，而不是生理性别。",
        "example": "西班牙语 *la mesa*，桌子"
      },
      "neuter": {
        "plain": "既不是阳性也不是阴性的那一类名词。",
        "example": "德语 *das Haus*，房子"
      },
      "animate": {
        "plain": "指人或动物的名词，有些语言为它们设有专门的词尾。",
        "example": "俄语 вижу *брата*，我看见我哥哥"
      },
      "inanimate": {
        "plain": "指物品而不是人或动物的名词。",
        "example": "俄语 вижу *стол*，我看见桌子"
      },
      "definite": {
        "plain": "说话双方都知道的特定那一个：the。",
        "example": "瑞典语 *huset*，这座房子"
      },
      "indefinite": {
        "plain": "任意一个，尚未知道的：a。",
        "example": "瑞典语 *ett hus*，一座房子"
      },
      "present": {
        "plain": "现在、一直如此，或习惯上如此。",
        "example": "she *walks*，她走路"
      },
      "past": {
        "plain": "现在之前。",
        "example": "she *walked*，她走了"
      },
      "future": {
        "plain": "比现在晚。",
        "example": "she *will walk*，她将会走"
      },
      "non-past": {
        "plain": "现在或以后：一个形式兼表两者。",
        "example": "日语 *食べる*，吃或将要吃"
      },
      "preterite": {
        "plain": "在过去某个时间点发生并已结束的事。",
        "example": "西班牙语 ayer *comí*，我昨天*吃了*"
      },
      "imperfect": {
        "plain": "从内部看过去：持续进行、反复发生或过去常常如此的事。",
        "example": "西班牙语 *comía*，我当时*在吃*，我以前*常吃*"
      },
      "perfect": {
        "plain": "在现在之前完成，而且现在仍有影响。",
        "example": "she *has walked*，她已经走了"
      },
      "pluperfect": {
        "plain": "在过去另一个时刻之前完成。",
        "example": "she *had walked*，她（那时）已经走了"
      },
      "aorist": {
        "plain": "把过去的动作当作一个完整事件来讲，就像讲故事那样。",
        "example": "保加利亚语 *писах*，我写了"
      },
      "indicative": {
        "plain": "陈述事实的普通形式：事实，以及关于事实的问题。",
        "example": "She *is* here.，她在这里。"
      },
      "subjunctive": {
        "plain": "表示希望、想要、怀疑、担心或只是想象的事，而不是说它确实如此。多用在 that、if、so that 这类词之后。",
        "example": "I wish he *were* here. It is vital that she *be* on time. 西班牙语 quiero que *vengas*，我希望他在这里。她必须准时。我想要你来。"
      },
      "subjunctive-i": {
        "plain": "德语用来转述别人的话、而不为其担保的形式。",
        "example": "Er sagt, er *sei* krank.，他说他病了。"
      },
      "subjunctive-ii": {
        "plain": "德语表示非真实情况的形式：愿望、礼貌请求，以及“要是……就好了”。",
        "example": "Wenn ich Zeit *hätte*...，要是我有时间……"
      },
      "conditional": {
        "plain": "如果另一件事成立，会发生什么。",
        "example": "she *would walk*，她会走"
      },
      "conditional-i": {
        "plain": "如果另一件事成立，会发生什么。",
        "example": "德语 ich *würde gehen*，我会去"
      },
      "conditional-ii": {
        "plain": "如果另一件事当时成立，本来会发生什么。",
        "example": "德语 ich *wäre gegangen*，我本来会去"
      },
      "future-i": {
        "plain": "比现在晚。",
        "example": "德语 ich *werde gehen*，我将会去"
      },
      "future-ii": {
        "plain": "到以后某个时间点已经完成。",
        "example": "德语 ich *werde gegangen sein*，我将已经去了"
      },
      "imperative": {
        "plain": "叫别人做某事的形式。",
        "example": "*Walk!*，走！"
      },
      "jussive": {
        "plain": "让或叫某人（常常不是听话人）做某事的形式。",
        "example": "阿拉伯语 *لِيَكْتُبْ*，让他写"
      },
      "optative": {
        "plain": "表示愿望的形式：但愿如此。"
      },
      "potential": {
        "plain": "表示大概或可能如此的形式。",
        "example": "芬兰语 *lienee*，（他）大概是"
      },
      "active": {
        "plain": "主语做动作。",
        "example": "She *wrote* the letter.，她写了这封信。"
      },
      "passive": {
        "plain": "主语承受动作。",
        "example": "The letter *was written*.，这封信被写好了。"
      },
      "infinitive": {
        "plain": "动词本身，还没有人去做：词典列出它时用的形式。",
        "example": "*to walk*, 西班牙语 *caminar*，走"
      },
      "participle": {
        "plain": "动词的一种形式，用法像形容词，加上助动词可构成其他时态。",
        "example": "a *broken* cup, she has *walked*，一个破了的杯子，她已经走了"
      },
      "gerund": {
        "plain": "动词的一种形式，表示正在进行的动作，或当名词用。",
        "example": "she is *walking*, 西班牙语 está *caminando*，她正在走"
      },
      "imperfective": {
        "plain": "把动作看作正在进行、反复或未完成。",
        "example": "俄语 я *читал*，我那时在读"
      },
      "perfective": {
        "plain": "把动作看作一个完整结束的整体。",
        "example": "俄语 я *прочитал*，我读完了"
      },
      "progressive": {
        "plain": "在那一刻正在进行。",
        "example": "她*正在走*"
      },
      "positive": {
        "plain": "形容词本来的样子，不作比较。",
        "example": "*大*"
      },
      "comparative": {
        "plain": "比别的东西更甚。",
        "example": "*更大*，*更美*"
      },
      "superlative": {
        "plain": "比其他一切都更甚。",
        "example": "*最大*，*最美*"
      },
      "strong": {
        "plain": "前面没有冠词表明格时，德语用的形容词词尾。",
        "example": "*kaltes* Wasser，冷水"
      },
      "weak": {
        "plain": "在 der、die、das 之后，冠词已表明格时，德语用的形容词词尾。",
        "example": "das *kalte* Wasser，这冷水"
      },
      "mixed": {
        "plain": "在 ein、kein、mein 之后德语用的形容词词尾。",
        "example": "ein *kaltes* Bier，一杯冰啤酒"
      },
      "formal": {
        "plain": "对陌生人、长辈和公文用。",
        "example": "*您*"
      },
      "informal": {
        "plain": "对朋友、家人和孩子用。",
        "example": "*你*"
      },
      "polite": {
        "plain": "表示尊敬的说法。",
        "example": "日语 *食べます*，（我）吃，礼貌说法"
      }
    }
  }
}

  "plain": {
    "categories": {
      "mood": {
        "plain": "Hogyan érti a beszélő, amit az ige mond: tényként, kívánságként, kétségként, elképzelésként vagy parancsként."
      },
      "tense": {
        "plain": "Mikor történik: korábban, most vagy később."
      },
      "aspect": {
        "plain": "Hogyan látjuk a cselekvést: egyetlen lezárt egészként, vagy folyamatban lévőként, ismétlődőként, befejezetlenként."
      },
      "person": {
        "plain": "Ki csinálja: a beszélő (én, mi), akihez beszél (te, ti), vagy valaki más (ő, ők)."
      },
      "number": {
        "plain": "Hány: egy, vagy több mint egy."
      },
      "case": {
        "plain": "Az az alak, amellyel a főnév a mondatbeli szerepét mutatja: ki csinál valamit, kinek, kié, hol."
      },
      "gender": {
        "plain": "Egy osztály, amelybe minden főnév tartozik, és amelyhez a körülötte lévő szavak igazodnak. A biológiai nemhez kevés köze van: a német das Mädchen, a lány, semlegesnemű."
      },
      "definiteness": {
        "plain": "Hogy egy bizonyos, ismert dologról van-e szó (a ház), vagy bármelyikről (egy ház)."
      },
      "declension": {
        "plain": "A végződések készlete, amelyet egy főnév vagy melléknév felvesz, a körülötte lévő szavaktól függően."
      },
      "degree": {
        "plain": "Milyen mértékben áll fenn a melléknév: nagy, nagyobb, a legnagyobb."
      },
      "voice": {
        "plain": "Hogy az alany végzi-e a cselekvést (ő írta), vagy elszenvedi (meg lett írva)."
      },
      "register": {
        "plain": "Mennyire hivatalos a szó: idegeneknek és hivatalos írásban, vagy barátoknak."
      },
      "nonfinite": {
        "plain": "Igealak, amely megnevezi a cselekvést, de nem mondja meg, ki végzi és mikor: menni, menő, ment."
      }
    },

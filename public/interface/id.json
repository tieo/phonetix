  "plain": {
    "categories": {
      "mood": {
        "plain": "Cara pembicara memaksudkan apa yang dikatakan kata kerja: sebagai fakta, sebagai sesuatu yang diharapkan, diragukan atau dibayangkan, atau sebagai perintah."
      },
      "tense": {
        "plain": "Kapan terjadinya: sebelum sekarang, sekarang, atau nanti."
      },
      "aspect": {
        "plain": "Cara tindakan itu dilihat: sebagai satu keseluruhan yang selesai, atau sebagai sesuatu yang berlangsung, berulang atau belum selesai."
      },
      "person": {
        "plain": "Siapa yang melakukannya: pembicara (saya, kami), lawan bicara (kamu), atau orang lain (dia, mereka)."
      },
      "number": {
        "plain": "Berapa banyak: satu, atau lebih dari satu."
      },
      "case": {
        "plain": "Bentuk yang diambil kata benda untuk menunjukkan perannya dalam kalimat: siapa yang melakukan sesuatu, kepada siapa, milik siapa, di mana."
      },
      "gender": {
        "plain": "Kelas yang dimiliki setiap kata benda, yang membuat kata di sekitarnya menyesuaikan diri. Hampir tidak ada hubungannya dengan jenis kelamin: das Mädchen dalam bahasa Jerman, gadis, adalah netral."
      },
      "definiteness": {
        "plain": "Apakah sesuatu itu satu yang tertentu dan sudah dikenal (rumah itu), atau salah satu saja (sebuah rumah)."
      },
      "declension": {
        "plain": "Kumpulan akhiran yang diambil kata benda atau kata sifat, bergantung pada kata di sekitarnya."
      },
      "degree": {
        "plain": "Seberapa kuat kata sifat itu: besar, lebih besar, paling besar."
      },
      "voice": {
        "plain": "Apakah subjek melakukan tindakan (dia menulisnya) atau tindakan itu dilakukan terhadapnya (itu ditulis)."
      },
      "register": {
        "plain": "Seberapa formal kata itu: untuk orang asing dan tulisan resmi, atau untuk teman."
      },
      "nonfinite": {
        "plain": "Bentuk kata kerja yang menyebut tindakan tanpa menyebut siapa yang melakukannya atau kapan: pergi, sedang pergi, sudah pergi."
      }
    },
    "values": {
      "singular": {
        "plain": "Satu dari sesuatu.",
        "example": "satu *anjing*"
      },
      "plural": {
        "plain": "Lebih dari satu.",
        "example": "*anjing-anjing*, banyak anjing"
      },
      "dual": {
        "plain": "Tepat dua, dalam bahasa yang punya bentuk khusus untuk pasangan.",
        "example": "Slovenia *hiši*, dua rumah"
      },
      "first-person": {
        "plain": "Pembicara: saya, atau kami.",
        "example": "*Saya* berjalan, *kami* berjalan"
      },
      "second-person": {
        "plain": "Lawan bicara: kamu.",
        "example": "*Kamu* berjalan"
      },
      "third-person": {
        "plain": "Siapa pun yang lain: dia, mereka, itu.",
        "example": "*Dia* berjalan"
      },
      "nominative": {
        "plain": "Pelaku tindakan: subjek.",
        "example": "*Anjing* itu menggigit pria itu."
      },
      "accusative": {
        "plain": "Yang dikenai tindakan: objek langsung.",
        "example": "Anjing itu menggigit *pria itu*."
      },
      "dative": {
        "plain": "Yang diberi atau dilakukan untuk sesuatu: kepada siapa.",
        "example": "Saya memberi *pria itu* sebuah buku."
      },
      "genitive": {
        "plain": "Milik siapa, atau bagian dari apa: milik, dari.",

      "second-person": {
        "plain": "Ten, s kým se mluví: ty.",
        "example": "*ty* jdeš"
      },
      "third-person": {
        "plain": "Kdokoli jiný: on, ona, ono, oni.",
        "example": "*ona* jde"
      },
      "nominative": {
        "plain": "Ten, kdo děj dělá: podmět.",
        "example": "*Pes* kouše muže."
      },
      "accusative": {

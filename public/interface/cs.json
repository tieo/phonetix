  "plain": {
    "categories": {
      "mood": {
        "plain": "Jak mluvčí myslí to, co sloveso říká: jako fakt, jako něco přané, pochybného nebo vymyšleného, nebo jako rozkaz."
      },
      "tense": {
        "plain": "Kdy se to děje: před teď, teď, nebo potom."
      },
      "aspect": {
        "plain": "Jak je děj viděn: jako jeden dokončený celek, nebo jako něco, co trvá, opakuje se nebo není dokončeno."
      },
      "person": {
        "plain": "Kdo to dělá: mluvčí (já, my), ten, s kým se mluví (ty), nebo někdo jiný (on, ona, oni)."
      },
      "number": {
        "plain": "Kolik: jeden, nebo víc než jeden."
      },
      "case": {
        "plain": "Tvar, který podstatné jméno dostane, aby ukázalo svou roli ve větě: kdo něco dělá, komu, čí, kde."
      },
      "gender": {
        "plain": "Třída, do které patří každé podstatné jméno, a slova kolem se podle ní mění. Má málo společného s pohlavím: v němčině das Mädchen, dívka, je střední rod."
      },
      "definiteness": {
        "plain": "Jestli jde o konkrétní, známou věc (ten dům), nebo o libovolnou (nějaký dům)."
      },
      "declension": {
        "plain": "Soubor koncovek, které podstatné jméno nebo přídavné jméno dostane podle slov kolem."
      },
      "degree": {
        "plain": "Jak moc přídavné jméno platí: velký, větší, největší."
      },
      "voice": {
        "plain": "Jestli podmět sám děj dělá (ona to napsala), nebo se na něm děj provádí (bylo to napsáno)."
      },
      "register": {
        "plain": "Jak formální slovo je: pro cizí lidi a úřední texty, nebo pro přátele."
      },
      "nonfinite": {
        "plain": "Tvar slovesa, který pojmenovává děj, aniž řekne, kdo ho dělá nebo kdy: psát, psaje, napsat."
      }
    },
    "values": {
      "singular": {
        "plain": "Jeden z čeho.",
        "example": "jeden *pes*"
      },
      "plural": {
        "plain": "Víc než jeden.",
        "example": "dva *psi*"
      },
      "dual": {
        "plain": "Přesně dva, v jazycích, které mají tvar jen pro dvojice.",
        "example": "slovinsky *hiši*, dva domy"
      },
      "first-person": {
        "plain": "Mluvčí: já, nebo my.",
        "example": "*já* jdu, *my* jdeme"

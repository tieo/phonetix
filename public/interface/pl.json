  "plain": {
    "categories": {
      "mood": {
        "plain": "Jak mówiący przedstawia to, co mówi czasownik: jako fakt, jako coś życzonego, wątpliwego lub wyobrażonego, albo jako rozkaz."
      },
      "tense": {
        "plain": "Kiedy to się dzieje: przed teraz, teraz albo później."
      },
      "aspect": {
        "plain": "Jak widziana jest czynność: jako jedna skończona całość, albo jako coś, co trwa, powtarza się lub jest nieskończone."
      },
      "person": {
        "plain": "Kto to robi: mówiący (ja, my), ten, do kogo się mówi (ty), albo ktoś inny (on, ona, oni)."
      },
      "number": {
        "plain": "Ile: jeden, albo więcej niż jeden."
      },
      "case": {
        "plain": "Forma, jaką przyjmuje rzeczownik, by pokazać swoją rolę w zdaniu: kto coś robi, komu, czyje, gdzie."
      },
      "gender": {
        "plain": "Klasa, do której należy każdy rzeczownik, a słowa wokół niego zmieniają się, by do niej pasować. Ma niewiele wspólnego z płcią: w niemieckim das Mädchen, dziewczyna, jest nijakie."
      },
      "definiteness": {
        "plain": "Czy chodzi o konkretną, znaną rzecz (dom) czy o dowolną (jakiś dom)."
      },
      "declension": {
        "plain": "Zestaw końcówek, jakie przyjmuje rzeczownik lub przymiotnik, zależnie od słów wokół."
      },
      "degree": {
        "plain": "Jak mocno przymiotnik się sprawdza: duży, większy, największy."
      },
      "voice": {
        "plain": "Czy podmiot wykonuje czynność (ona napisała to), czy czynność jest wykonywana na nim (zostało to napisane)."
      },
      "register": {
        "plain": "Jak formalne jest słowo: dla obcych i pism urzędowych, czy dla przyjaciół."
      },
      "nonfinite": {
        "plain": "Forma czasownika, która nazywa czynność, nie mówiąc, kto ją wykonuje ani kiedy: iść, idąc, pójść."
      }
    },
    "values": {
      "singular": {
        "plain": "Jeden z czegoś.",
        "example": "jeden *pies*"
      },
      "plural": {
        "plain": "Więcej niż jeden.",
        "example": "dwa *psy*"
      },
      "dual": {
        "plain": "Dokładnie dwa, w językach, które mają osobną formę tylko dla par.",
        "example": "słoweński *hiši*, dwa domy"
      },
      "first-person": {
        "plain": "Mówiący: ja, albo my.",
        "example": "*ja* idę, *my* idziemy"
      },
      "second-person": {
        "plain": "Ten, do kogo się mówi: ty.",
        "example": "*ty* idziesz"
      },
      "third-person": {
        "plain": "Ktokolwiek inny: on, ona, ono, oni.",
        "example": "*ona* idzie"
      },
      "nominative": {
        "plain": "Ten, kto wykonuje czynność: podmiot.",
        "example": "*Pies* gryzie człowieka."

node_modules
.output
.wxt
.cache

# Copied from node_modules at postinstall (23 MB)
public/espeak/

# Built from kaikki.org data (run: pnpm build:dict)
assets/dictionaries/

# Large data files (research/build artifacts, not extension runtime)
scripts/data/
src/public/languages_with_audio/
src/public/languages_without_audio/
scripts/proofread/out/
__pycache__/

# The core, compiled for the browser (run: pnpm build:core)
src/core/wasm/
public/core/

# Built from assets/dictionaries by the app's own build, like the native library beside it
android/app/src/main/assets/ipa-en.pack

# The synthesiser and its data, built by scripts/build-espeak-android.sh. A checked-in binary
# is a build artefact pretending to be source, and it drifts the moment the build changes.
android/app/src/main/assets/espeak/
android/app/src/main/jniLibs/*/libespeak-ng.so

# Android app
android/.gradle/
android/build/
android/app/build/
android/local.properties

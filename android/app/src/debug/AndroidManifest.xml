<?xml version="1.0" encoding="utf-8"?>
<!--
  The page the tests are driven against, and only in a debug build.

  It is exported, because a test starts it over adb with the scroll position and the settings
  a check needs - and those settings are the app's own: whether the overlay is on, how often it
  transcribes, whether the words take touches. An exported activity that writes them belongs
  nowhere near a build a reader installs, where any app on the device could start it and
  quietly reconfigure this one.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".debug.DebugSurfaceActivity"
            android:exported="true"
            android:label="Phonetix test surface"
            android:launchMode="singleTop" />
    </application>
</manifest>

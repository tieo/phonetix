<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The overlay that paints the transcriptions over whatever app is in front. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- The recordings and the sagittal diagrams behind a symbol come from Wikimedia, the
         same files the extension links to. Nothing is sent, only fetched. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Listing installed apps for the per-app picker. The launcher-intent query is
         enough, so the app never needs the far broader QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Phonetix">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Phonetix">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Drives the scroll-tracking test; exported so adb can start it with an exact
             scroll position. It carries no data and does nothing on its own. -->
        <activity
            android:name=".debug.DebugSurfaceActivity"
            android:exported="true"
            android:label="Phonetix test surface"
            android:launchMode="singleTop" />

        <service
            android:name=".service.PhonetixAccessibilityService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>

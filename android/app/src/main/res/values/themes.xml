<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose paints everything; the platform theme only needs to get out of the way
         and let the window go edge to edge. -->
    <style name="Theme.Phonetix" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>

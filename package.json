{
  "name": "wxt-svelte-starter",
  "description": "manifest.json description",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "install:browsers": "node scripts/install-browsers.mjs",
    "postinstall": "pnpm run install:browsers && wxt prepare"
  },
  "devDependencies": {
    "@iconify-json/emojione-v1": "^1.2.3",
    "@iconify-json/fluent-emoji-flat": "^1.2.5",
    "@iconify-json/line-md": "^1.2.11",
    "@iconify-json/logos": "^1.2.10",
    "@iconify-json/noto": "^1.2.7",
    "@iconify-json/pixelarticons": "^1.2.2",
    "@iconify-json/qlementine-icons": "^1.2.13",
    "@iconify-json/twemoji": "^1.2.5",
    "@puppeteer/browsers": "^2.11.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tsconfig/svelte": "^5.0.6",
    "@types/chrome": "^0.1.32",
    "@wxt-dev/module-svelte": "^2.0.4",
    "autoprefixer": "^10.4.23",
    "daisyui": "5.5.14",
    "eslint": "^9.39.2",
    "eslint-plugin-svelte": "^3.13.1",
    "svelte": "^5.46.0",
    "svelte-check": "^4.3.5",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "unplugin-icons": "^22.5.0",
    "wxt": "^0.20.13"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@webext-core/messaging": "^2.3.0",
    "@yutengjing/eld": "^0.0.2",
    "chromium": "^3.0.3",
    "msgpackr": "^1.11.8",
    "superjson": "^2.2.6",
    "tailwindcss": "^4.1.18",
    "zod": "^4.2.1"
  }

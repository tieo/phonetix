{
  "name": "phonetix",
  "description": "Browser extension that shows IPA pronunciations on web pages",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --experimental-strip-types scripts/test-homograph.ts && node --experimental-strip-types scripts/test-resolution.ts && node --experimental-strip-types scripts/test-langdetect.ts",
    "test:integration": "uv run python scripts/proofread/suite.py integration",
    "test:e2e": "uv run python scripts/proofread/suite.py e2e",
    "test:firefox": "uv run --with marionette_driver python scripts/proofread/firefox_check.py",
    "test:packs": "uv run python scripts/proofread/pack_check.py",
    "test:all": "pnpm test && pnpm test:integration && pnpm test:e2e",
    "install:browsers": "node scripts/install-browsers.mjs",
    "build:dict": "node scripts/build-dictionaries.mjs",
    "fetch:dict": "node scripts/fetch-dictionaries.mjs",
    "postinstall": "pnpm run install:browsers && node scripts/copy-espeak.mjs && wxt prepare"
  },
  "devDependencies": {
    "@iconify-json/line-md": "^1.2.14",
    "@iconify-json/pixelarticons": "^1.2.4",
    "@puppeteer/browsers": "^2.13.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/chrome": "^0.1.37",
    "@wxt-dev/module-svelte": "^2.0.4",
    "autoprefixer": "^10.4.27",
    "daisyui": "5.5.19",
    "eslint": "^10.0.2",
    "eslint-plugin-svelte": "^3.15.0",
    "svelte": "^5.53.6",
    "svelte-check": "^4.4.4",
    "svelte-multiselect": "^11.6.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "unplugin-icons": "^23.0.1",
    "wxt": "^0.20.18"
  },
  "dependencies": {
    "@echogarden/espeak-ng-emscripten": "^0.3.5",
    "@tailwindcss/vite": "^4.2.1",
    "@webext-core/messaging": "^2.3.0",
    "@yutengjing/eld": "^0.0.2",
    "idb-keyval": "^6.2.2",
    "tailwindcss": "^4.2.1"
  },
  "packageManager": "pnpm@11.11.0"
}

{
  "name": "phonetix",
  "description": "Browser extension that shows IPA pronunciations on web pages",
  "private": true,
  "version": "0.38.6",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "cd core && cargo test --workspace",
    "install:browsers": "node scripts/install-browsers.mjs",
    "build:core": "node scripts/build-core-wasm.mjs",
    "fetch:dict": "node scripts/fetch-dictionaries.mjs",
    "postinstall": "pnpm run install:browsers && node scripts/copy-espeak.mjs && wxt prepare",
    "test:names": "uv run --with ipapy python scripts/proofread/symbol_names.py",
    "test:overlay": "cd android && ./gradlew assembleDebug -q && cd .. && uv run python scripts/proofread/android_overlay.py",
    "test:features": "uv run python scripts/proofread/android_features.py",
    "test:lex": "uv run python scripts/proofread/lex_extension.py",
    "test:cards": "uv run python scripts/proofread/card_states.py",
    "test:page": "uv run python scripts/proofread/on_a_page.py",
    "test:settings": "uv run python scripts/proofread/settings_view.py",
    "ci": "scripts/ci.sh",
    "release": "scripts/release.sh",
    "ci:fast": "scripts/ci.sh fast",
    "hooks": "scripts/hooks/install.sh"
  },
  "devDependencies": {
    "@iconify-json/line-md": "^1.2.14",
    "@iconify-json/pixelarticons": "^1.2.4",
    "@puppeteer/browsers": "^2.13.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/chrome": "^0.1.37",
    "@wxt-dev/module-svelte": "^2.0.4",
    "autoprefixer": "^10.4.27",
    "daisyui": "5.5.19",
    "eslint": "^10.0.2",
    "eslint-plugin-svelte": "^3.15.0",
    "svelte": "^5.53.6",
    "svelte-check": "^4.4.4",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "wxt": "^0.20.18"
  },
  "dependencies": {
    "@echogarden/espeak-ng-emscripten": "^0.3.5",
    "@webext-core/messaging": "^2.3.0",
    "@yutengjing/eld": "^0.0.2",
    "idb-keyval": "^6.2.2"
  },
  "packageManager": "pnpm@11.11.0"
}
